{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Recast",
  "description": "Build components once. Use everywhere.",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "favicon": "/favicon.svg",
  "colors": {
    "primary": "#181822",
    "light": "#ffffff",
    "dark": "#181822"
  },
  "anchors": [
    {
      "name": "GitHub",
      "icon": "github",
      "url": "https://github.com/reactivepixels/recast"
    },
    {
      "name": "npm",
      "icon": "box",
      "url": "https://www.npmjs.com/package/@rpxl/recast"
    }
  ],
  "navigation": {
    "groups": [
      {
        "group": "Getting Started",
        "pages": ["index", "installation", "quickstart"]
      },
      {
        "group": "Core Concepts",
        "pages": [
          "concepts/styles",
          "concepts/variants",
          "concepts/modifiers",
          "concepts/composition",
          "concepts/conditional-styling"
        ]
      },
      {
        "group": "Examples",
        "pages": [
          "examples/button",
          "examples/card",
          "examples/form-components",
          "examples/layout-components"
        ]
      },
      {
        "group": "Guides",
        "pages": [
          "guides/typescript",
          "guides/performance",
          "guides/best-practices"
        ]
      },
      {
        "group": "API Reference",
        "pages": [
          "api/recast-styles",
          "api/recast-compose",
          "api/recast-configure",
          "api/types"
        ]
      }
    ]
  }
}
